@startuml SprinkleUp
' Paste into https://www.plantuml.com/plantuml or use IntelliJ's PlantUML plugin to export a PNG.
skinparam classAttributeIconSize 0
skinparam linetype ortho

package model {
  abstract class BaseEntity {
    - id : Long
    - createdAt : LocalDateTime
    - updatedAt : LocalDateTime
    + getId() : Long
    + isNew() : boolean
    + {abstract} getDisplayName() : String
  }

  abstract class User {
    - fullName : String
    - email : String
    - phone : String
    - passwordHash : String
    + {abstract} getRole() : UserRole
    + {abstract} getHomePath() : String
    + isAdmin() : boolean
    + hasAccount() : boolean
    + setPassword(raw : String, encoder : PasswordEncoder)
    + checkPassword(raw : String, encoder : PasswordEncoder) : boolean
  }

  class Customer {
    - address : String
    + getRole() : UserRole
    + getHomePath() : String
    + updateDetails(source : Customer)
  }

  class Admin {
    - jobTitle : String
    + getRole() : UserRole
    + getHomePath() : String
  }

  abstract class Product {
    - name : String
    - description : String
    - basePrice : BigDecimal
    - stock : int
    - available : boolean
    + {abstract} getType() : ProductType
    + {abstract} getUnitPrice() : BigDecimal
    + {abstract} getSpecs() : String
    + {abstract} applySpecs(form : ProductForm)
    + {abstract} fillSpecs(form : ProductForm)
    + priceFor(quantity : int) : BigDecimal
    + isInStock() : boolean
    + reduceStock(quantity : int)
    + restock(quantity : int)
  }

  class Cake {
    - weightKg : Double
    - flavour : String
    - eggless : Boolean
    + getUnitPrice() : BigDecimal
  }
  class Cupcake {
    - piecesPerBox : Integer
    - frosting : String
    + getUnitPrice() : BigDecimal
  }
  class Bread {
    - weightGrams : Integer
    - sliced : Boolean
    + getUnitPrice() : BigDecimal
  }
  class Pastry {
    - filling : String
    - servedWarm : Boolean
    + getUnitPrice() : BigDecimal
  }

  abstract class AbstractOrder {
    + {abstract} getKindLabel() : String
    + {abstract} getSummary() : String
    + {abstract} getTotal() : BigDecimal
    + {abstract} getStatusLabel() : String
    + {abstract} getDueDate() : LocalDate
    + {abstract} getCustomerPath() : String
    + belongsTo(user : User) : boolean
  }

  class Order {
    - status : OrderStatus
    - pickupDate : LocalDate
    - notes : String
    + addItem(product : Product, quantity : int)
    + getTotal() : BigDecimal
    + changeStatus(newStatus : OrderStatus)
    + returnItemsToStock()
    + getItems() : List<OrderItem> {read-only}
  }

  class CustomOrder {
    - occasion : String
    - flavour : String
    - weightKg : double
    - tiers : int
    - eggless : boolean
    - design : String
    - messageOnCake : String
    - neededBy : LocalDate
    - budget : BigDecimal
    - quotedPrice : BigDecimal
    - bakerNote : String
    - status : CustomOrderStatus
    + updateRequest(form : CustomOrderForm)
    + quote(price : BigDecimal, note : String)
    + accept()
    + cancel()
    + changeStatus(newStatus : CustomOrderStatus)
    + getTotal() : BigDecimal
  }

  class OrderItem {
    - productName : String
    - quantity : int
    - unitPrice : BigDecimal
    + getLineTotal() : BigDecimal
  }

  enum UserRole {
    CUSTOMER
    ADMIN
  }

  enum ProductType {
    CAKE
    CUPCAKE
    BREAD
    PASTRY
    + newProduct() : Product
  }

  enum OrderStatus {
    PENDING
    BAKING
    READY
    DELIVERED
    CANCELLED
    + isClosed() : boolean
  }

  enum CustomOrderStatus {
    REQUESTED
    QUOTED
    ACCEPTED
    IN_PROGRESS
    COMPLETED
    DECLINED
    CANCELLED
    + isClosed() : boolean
    + needsPrice() : boolean
  }
}

package service {
  interface "CrudService<T>" as CrudService {
    + findAll() : List<T>
    + findById(id : Long) : T
    + count() : long
    + delete(id : Long)
  }
  abstract class "AbstractCrudService<T extends BaseEntity>" as AbstractCrudService {
    - repository : JpaRepository<T, Long>
    # {abstract} entityName() : String
    # save(entity : T) : T
  }
  class ProductService
  class CustomerService
  class OrderService
  class CustomOrderService
  class AuthService {
    + signIn(email : String, password : String) : User
    + register(form : RegisterForm) : Customer
    + changePassword(...)
  }
}

BaseEntity <|-- User
BaseEntity <|-- Product
BaseEntity <|-- AbstractOrder
User <|-- Customer
User <|-- Admin
Product <|-- Cake
Product <|-- Cupcake
Product <|-- Bread
Product <|-- Pastry
AbstractOrder <|-- Order
AbstractOrder <|-- CustomOrder

Customer "1" <-- "0..*" AbstractOrder : placed by
Order "1" *-- "1..*" OrderItem : contains
OrderItem "0..*" --> "0..1" Product : refers to
Order --> OrderStatus
CustomOrder --> CustomOrderStatus
User ..> UserRole
Product ..> ProductType

CrudService <|.. AbstractCrudService
AbstractCrudService <|-- ProductService
AbstractCrudService <|-- CustomerService
AbstractCrudService <|-- OrderService
AbstractCrudService <|-- CustomOrderService
OrderService --> ProductService
OrderService --> CustomerService
@enduml
